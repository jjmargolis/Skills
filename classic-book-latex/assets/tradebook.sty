% tradebook.sty -- classic American trade-book interior. Compile with xelatex.
% Class: \documentclass[11pt,twoside,openright]{book}
\ProvidesPackage{tradebook}
\RequirePackage[paperwidth=6.125in,paperheight=9.25in,textwidth=27pc,lines=39,
  inner=.8in,top=.85in,headsep=1.2pc,headheight=14pt]{geometry}
\RequirePackage{fontspec,microtype,titletoc,fancyhdr,graphicx,afterpage,pdflscape}
\RequirePackage[newparttoc]{titlesec}

% ---- type: Times body with old-style figures; Bodoni Bold display
\setmainfont{texgyretermes}[Extension=.otf,UprightFont=*-regular,ItalicFont=*-italic,
  BoldFont=*-bold,BoldItalicFont=*-bolditalic,Numbers=OldStyle]
\IfFontExistsTF{LibreBodoni-Bold.ttf}
  {\newfontfamily\display{LibreBodoni-Bold.ttf}[WordSpace=1.5]}
  {\PackageWarningNoLine{tradebook}{LibreBodoni-Bold.ttf not found; using Times Bold}%
   \newcommand\display{\bfseries}}
\newcommand\spacedcaps[1]{{\addfontfeature{LetterSpace=18}\textsc{\MakeLowercase{#1}}}}
\raggedbottom

% ---- running heads: verso = part title (else \booktitle) in spaced small caps;
%      recto = chapter title in italic; folio at outer edge; none on openers
\newcommand\booktitle[1]{\gdef\tb@title{#1}}\def\tb@title{}
\newcommand\tb@verso{\edef\tb@l{\leftmark}\spacedcaps{\ifx\tb@l\empty\tb@title\else\leftmark\fi}}
\pagestyle{fancy}\fancyhf{}\renewcommand\headrulewidth{0pt}
\fancyhead[CE]{\footnotesize\tb@verso}\fancyhead[CO]{\textit{\rightmark}}
\fancyhead[LE,RO]{\thepage}
\renewcommand\chaptermark[1]{\markright{#1}}
\markboth{}{}

% ---- part: own recto page, "Part I" over letterspaced caps
\newcommand\tb@part[1]{\markboth{#1}{}\MakeUppercase{#1}}
\titleclass{\part}{page}\assignpagestyle{\part}{empty}
\titleformat{\part}[display]{\display\centering}{\LARGE Part\enspace\thepart}{2.5pc}
  {\Huge\addfontfeature{LetterSpace=12}\tb@part}
\titlespacing*{\part}{0pt}{7pc}{0pt}

% ---- chapter: number, then larger title, centered
\assignpagestyle{\chapter}{empty}
\titleformat{\chapter}[display]{\display\centering}{\LARGE\thechapter}{2.2pc}{\huge}
\titlespacing*{\chapter}{0pt}{2pc}{3.5pc}

% ---- contents: hanging labels, no leaders, narrow measure
\newcommand\tb@lab[1]{\makebox[0pt][r]{#1\hspace{1pc}}}
\newcommand\tb@pg{\hfill\thecontentspage\hspace*{2pc}}
\contentsmargin{0pt}
\titlecontents{part}[6pc]{\addvspace{.9pc}}
  {\tb@lab{\textsc{part\enspace\MakeLowercase{\thecontentslabel}}}\MakeUppercase}
  {\MakeUppercase}{\tb@pg}[\vspace{.2pc}]
\titlecontents{chapter}[6pc]{}{\tb@lab{\thecontentslabel}}{}{\tb@pg}
\titlecontents{front}[6pc]{\itshape}{}{}{\tb@pg}[\vspace{.3pc}]

% ---- text commands
% \front{Introduction}: unnumbered chapter with italic contents entry
\newcommand\front[1]{\chapter*{#1}\markright{#1}\addcontentsline{toc}{front}{#1}}
% \lead{As late as}: caps-and-small-caps opening words
\newcommand\lead[1]{\noindent{\addfontfeature{LetterSpace=4}\textsc{#1}}}
% \scene{No radio}: two-line space break, then lead-in
\newcommand\scene[1]{\par\vspace{2\baselineskip}\lead{#1}}
% quote: block quotation, 1.5pc each side, one line above and below
\renewenvironment{quote}{\list{}{\leftmargin1.5pc\rightmargin1.5pc
  \topsep\baselineskip\partopsep0pt\parsep0pt}\item\relax}{\endlist}

% ---- figures (numbered; cite with \label inside the caption and \ref)
\newcommand\tb@cap[1]{{\centering\refstepcounter{figure}%
  {\footnotesize\spacedcaps{Figure \thefigure}}\par\vspace{.2pc}{\small\itshape #1\par}}}
\newcommand\tb@rule{\hrule height .4pt}
% \exhibit[t|b]{file}{Caption.}: full-measure figure between hairline rules
\newcommand\exhibit[3][t]{\begin{figure}[#1]\tb@rule\vspace{.6pc}\tb@cap{#3}\vspace{.6pc}
  \centering\includegraphics[width=\textwidth]{#2}\par\vspace{.5pc}\tb@rule\end{figure}}
% \plate{file}{Caption.}: figure on the next page by itself; \plate[l] turns that page landscape
\newcommand\tb@plate[2]{\thispagestyle{empty}\vspace*{\fill}\noindent\begin{minipage}{\linewidth}
  \tb@rule\vspace{.6pc}\tb@cap{#2}\vspace{.6pc}\centering
  \includegraphics[width=\linewidth,height=\dimexpr\textheight-6pc\relax,keepaspectratio]{#1}%
  \par\vspace{.5pc}\tb@rule\end{minipage}\vspace*{\fill}}
\newcommand\plate[3][p]{\afterpage{\if l#1\begin{landscape}\tb@plate{#2}{#3}\end{landscape}%
  \else\clearpage\tb@plate{#2}{#3}\clearpage\fi}}
